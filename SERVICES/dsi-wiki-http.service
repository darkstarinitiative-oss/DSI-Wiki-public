[Unit]
Description=DSI-Wiki Gateway - combined API/MCP/UI ASGI service, mounted at /api /mcp /http
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/user/BASE/MAIN/DSI-Wiki/CODE/gateway
ExecStart=/usr/bin/python3 /home/user/BASE/MAIN/DSI-Wiki/CODE/gateway/DSI-Wiki-HTTP-Server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=zulfikar.target
