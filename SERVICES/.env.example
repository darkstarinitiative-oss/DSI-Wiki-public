# DSI-Wiki environment — copy to SERVICES/.env and fill in.
# Read by: docker-compose.yml (both services) directly, and by setup.sh's
# non-docker path, which copies the resolved values into CODE/ingest/.env.
#
# --- Host paths (bind-mounted into the containers; also used directly by the
#     non-docker/systemd path) ---
WIKI_RAW_DIR=/path/to/Wiki-RAW
WIKI_ARCHIVE_DIR=/path/to/Wiki-ARCHIVE
WIKI_BASE_DIR=/path/to/Wiki-BASE
INSTANCES_DIR=/path/to/DSI-Wiki/JSONS/instances
# Container runs as this UID:GID (default 1000:1000) instead of root, so files it writes into
# the bind-mounted dirs above come out owned by your host user -- set these to `id -u`/`id -g`
# if your host user isn't 1000:1000. Only takes effect on `docker compose ... up --build`
# (build-time ARGs), not a plain `up` on an already-built image.
APP_UID=1000
APP_GID=1000
WIKI_LOCK_DIR=/path/to/Wiki-DATA

# --- Ingest daemon ---
LLM_WIKI_POLL_INTERVAL=60
LLM_WIKI_CLAUDE_TIMEOUT=300
LLM_WIKI_ROUTES=/path/to/DSI-Wiki/JSONS/DSI-Wiki-Multi-Server-Config.json

# --- Ollama (host-side; containers reach it via host.docker.internal) ---
LLM_WIKI_OLLAMA_URL=http://host.docker.internal:11434/api/chat
LLM_WIKI_OLLAMA_MODEL=qwen3:4b
# Optional: set to point at any Ollama/OpenAI-wire-compatible endpoint that needs bearer auth
# instead of local Ollama -- Ollama Cloud, a self-hosted router in front of multiple backends,
# etc. Leave empty for local Ollama (no Authorization header sent). See DOCS/llm-backend-roadmap.md.
LLM_WIKI_OLLAMA_API_KEY=
# "ollama" (default) or "claude-code" (shells out to the `claude` CLI instead -- only works if
# it's on PATH and authenticated wherever run_llm() actually executes; not available in the
# Docker image today, see DOCS/llm-backend-roadmap.md). Real per-call API cost if set.
LLM_WIKI_BACKEND=ollama

# --- Gateway ---
SERVICE_PORT=8430

# --- systemd (non-docker path only; setup.sh fills these) ---
SERVICE_DESCRIPTION=DSI-Wiki Ingest Service - polls raw/ for new notes and generates documentation/llm/minified layers via Ollama
SERVICE_AFTER=network.target
SERVICE_TYPE=simple
SERVICE_WORKING_DIRECTORY=/path/to/DSI-Wiki/CODE/ingest
SERVICE_EXEC_START=/usr/bin/python3 /path/to/DSI-Wiki/CODE/ingest/DSI-Wiki-Ingest-Service-Class.py
SERVICE_RESTART=on-failure
SERVICE_RESTART_SEC=5
SERVICE_WANTED_BY=zulfikar.target

# --- Git publishing credentials (optional) ---
# Only needed if you push wiki content/changes to a git remote.
# Keep real values OUT of this repo: put them in a private env file or a
# git credential store, e.g.:
#   git config credential.helper 'store --file /secure/path/git-store'
# GITLAB_USER=oauth2
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
