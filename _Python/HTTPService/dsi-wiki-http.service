[Unit]
Description=DSI-Wiki Gateway - combined API/MCP/UI ASGI service, mounted at /api /mcp /http
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ozan/CLEANUP/MAIN/DSI-Wiki/_Python/HTTPService
ExecStart=/usr/bin/python3 /home/ozan/CLEANUP/MAIN/DSI-Wiki/_Python/HTTPService/DSI-Wiki-HTTP-Server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=zulfikar.target
